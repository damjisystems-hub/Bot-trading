//@version=5
indicator("CRT · lo que aprendió el bot", shorttitle="CRT", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)
// Generado por tradingview/generar.py a partir de tradingview/plantilla.pine: no lo editéis a mano.
//
// Las mismas reglas que el bot CRT de Python (carpeta crt/) y que el bot de MT5 (mt5/BotCRT.mq5), para el
// gráfico de 15 minutos. Monta sus propias velas de 1H, 3H, 4H y diario en hora de Nueva York (el día de
// trading va de 17:00 a 17:00). Las semanales y las mensuales salen de la historia larga de TradingView.
// Las reglas están explicadas en ESTRATEGIA.md. Si cambia una regla, se cambia allí, en crt/, en MT5 y aquí.

// ───────────────────────── Ajustes ─────────────────────────

G_REGLAS = "Reglas (las del bot)"
ratio = input.float(2.0, "TP: veces lo que se arriesga (1 a 2)", minval=0.5, step=0.5, group=G_REGLAS)
espera = input.int(45, "Minutos sin entrar tras la apertura de las 9:30 (NY)", minval=0, group=G_REGLAS)
desdeTxt = input.string("01:00", "Entradas desde (hora de Nueva York)", group=G_REGLAS)
hastaTxt = input.string("13:00", "Entradas hasta (hora de Nueva York)", group=G_REGLAS)
maxOpsIn = input.int(2, "Máximo de operaciones al día", minval=1, group=G_REGLAS)
topeR = input.float(3.0, "Tope de pérdida del día, en R (0 = sin tope)", minval=0, group=G_REGLAS)
inicio4h = input.int(17, "Las velas de 4H empiezan a esta hora de NY (17: las de la 1, las 5 y las 9)", minval=0, maxval=23, group=G_REGLAS)
comprobarObjDiario = input.bool(true, "No entrar si el TP queda más allá del objetivo del diario", group=G_REGLAS)
sesgoEquipo = input.string("El que calcula el bot", "Sesgo de esta semana", options=["El que calcula el bot", "Compras", "Ventas", "Ninguno"], group=G_REGLAS, tooltip="Lo que confirmáis o cambiáis cada lunes. Solo vale para la semana en curso: la historia se repasa siempre con el del bot.")

G_CAND = "Reglas candidatas (apagadas: en 20 años no ganan)"
anticipoSin1h = input.bool(false, "4H anticipado sin esperar al 1H (barrido, vuelta dentro y order block)", group=G_CAND)
sinVetoMensual = input.bool(false, "Sesgo: manda el semanal aunque el mensual vaya en contra", group=G_CAND)
modeloBacktest = input.bool(false, "Modelo del backtest del autor: sin sesgo ni diario, hasta 3 al día", group=G_CAND)

G_COSTES = "Costes"
difIn = input.float(-1.0, "Diferencial, en precio (-1 = el del bot para este mercado)", group=G_COSTES)
colIn = input.float(-1.0, "Colchón del stop detrás del barrido, en precio (-1 = el del bot)", group=G_COSTES)

G_VER = "Qué enseñar"
verDescartadas = input.bool(true, "Las señales que descarta, con el motivo", group=G_VER)
verNiveles = input.bool(true, "El rango de 4H y el objetivo del diario de ahora", group=G_VER)
verCasos = input.bool(true, "Los casos del examen (situaciones de los vídeos)", group=G_VER)
verPanel = input.bool(true, "El panel y los resultados", group=G_VER)

NY = "America/New_York"
esM15 = timeframe.period == "15"

f_minutos(string s) =>
    array<string> p = str.split(s, ":")
    int r = -1
    if array.size(p) == 2
        r := int(str.tonumber(array.get(p, 0))) * 60 + int(str.tonumber(array.get(p, 1)))
    r

desdeM = f_minutos(desdeTxt)
hastaM = f_minutos(hastaTxt)

// El mercado del gráfico y lo que cuesta entrar en él (crt/mercados.py).
tk = str.upper(syminfo.ticker)
mercado = str.contains(tk, "EURUSD") ? "eurusd" : str.contains(tk, "GBPUSD") ? "gbpusd" : (str.contains(tk, "XAU") or str.contains(tk, "GOLD")) ? "oro" : (str.contains(tk, "NAS") or str.contains(tk, "US100") or str.contains(tk, "USTEC") or str.contains(tk, "NQ") or str.contains(tk, "NDX")) ? "nasdaq" : "otro"
difBot = mercado == "nasdaq" ? 1.5 : mercado == "eurusd" ? 0.00008 : mercado == "gbpusd" ? 0.00012 : mercado == "oro" ? 0.3 : 0.0
colBot = mercado == "nasdaq" ? 3.0 : mercado == "eurusd" ? 0.0001 : mercado == "gbpusd" ? 0.00015 : mercado == "oro" ? 0.5 : 0.0
nombreMercado = mercado == "nasdaq" ? "NASDAQ" : mercado == "eurusd" ? "EUR/USD" : mercado == "gbpusd" ? "GBP/USD" : mercado == "oro" ? "Oro (XAU/USD)" : syminfo.ticker
dif = difIn >= 0 ? difIn : difBot
col = colIn >= 0 ? colIn : colBot
maxOps = modeloBacktest ? 3 : maxOpsIn

// ───────────────────────── Tipos ─────────────────────────

// Una vela de un marco, hecha con barras de 15 minutos. iIni e iFin: su primera y su última barra.
type Vela
    int t
    float o
    float h
    float l
    float c
    int iIni
    int iFin

// Lo que forma la vela 2 respecto a la vela 1: un rango (toma un extremo y cierra dentro) o una ruptura.
type Evento
    int id
    bool rango
    int dir
    int iFormado
    int iVelaIni
    float objetivo
    float barrido
    string escenario = "otro"
    float vela1Rel
    int estado = 0
    int velasDesde = 0
    int velasHastaCompletar = -1

// Un marco de tiempo: sus velas cerradas (las últimas 21), la vela en curso y su último evento.
type Marco
    string nombre
    int codigo
    array<Vela> cerradas
    Vela parcial
    int clave = -1
    Evento ultimo
    int barridoAlc = -1
    int barridoBaj = -1

// Un rango a favor desde el que buscar la entrada: cerrado o anticipado.
type Setup
    int idea1
    int idea2
    int dir
    float barrido
    float objetivo
    int iInicio
    string via
    string escenario
    float vela1Rel

type Op
    int dir
    float entrada
    float stop
    float tp
    float riesgo
    line lE
    line lS
    line lT

type Estado
    Op op
    Vela anterior
    int n = 0
    int ganadas = 0
    float total = 0.0
    int racha = 0
    int peorRacha = 0
    float acum = 0.0
    float pico = 0.0
    float peorCaida = 0.0
    int primera = 0
    int ultimaCierre = 0
    int kWPrev = 0
    int diaPrev = 0
    float cierrePrev = na
    int senal = 0
    bool cierreSemanal = false
    string aviso = ""

// ───────────────────────── Estado ─────────────────────────

var contador = array.new_int(1, 0)
var Marco h1 = Marco.new("H1", 1, array.new<Vela>())
var Marco h3 = Marco.new("H3", 2, array.new<Vela>())
var Marco h4 = Marco.new("H4", 3, array.new<Vela>())
var Marco d1 = Marco.new("D1", 4, array.new<Vela>())
var Evento wU = na
var Evento mU = na
var Estado est = Estado.new()
var usados = array.new_int()
var vistos = array.new_int()
var map<int, float> rDia = map.new<int, float>()
var map<int, int> opsDia = map.new<int, int>()

// ───────────────────────── Rangos (crt/rangos.py) ─────────────────────────

f_evaluar(Vela v1, Vela v2) =>
    bool tomaMin = v2.l < v1.l
    bool tomaMax = v2.h > v1.h
    Evento e = na
    if v2.c > v1.h
        e := Evento.new(0, false, 1, v2.iFin, v2.iIni)
    else if v2.c < v1.l
        e := Evento.new(0, false, -1, v2.iFin, v2.iIni)
    else if tomaMin and not tomaMax
        e := Evento.new(0, true, 1, v2.iFin, v2.iIni, v1.h, v2.l)
    else if tomaMax and not tomaMin
        e := Evento.new(0, true, -1, v2.iFin, v2.iIni, v1.l, v2.h)
    e

// Verde: rango a favor activo. Rojo: rango en contra activo o ruptura en contra. Ámbar: lo demás.
f_semaforo(Evento u, int d) =>
    string r = "ambar"
    if not na(u)
        if not u.rango
            r := u.dir != d ? "rojo" : "ambar"
        else if u.estado == 0
            r := u.dir == d ? "verde" : "rojo"
    r

f_escenario(Evento p, int d) =>
    string r = "otro"
    if not na(p)
        if p.rango and p.dir != d
            if p.estado == 0
                r := "3"
            else if p.estado == 1
                r := p.velasHastaCompletar == 1 ? "2" : "1"
    r

// Hacia dónde empuja el último evento de un marco grande (sesgo de fondo).
f_direccion(Evento u) =>
    int r = 0
    if not na(u)
        if not u.rango
            r := u.dir
        else if u.estado == 0
            r := u.dir
    r

f_completar(Evento u, Vela b) =>
    if not na(u)
        if u.rango and u.estado == 0 and u.iFormado < b.iFin
            if (u.dir > 0 and b.h >= u.objetivo) or (u.dir < 0 and b.l <= u.objetivo)
                u.estado := 1
                u.velasHastaCompletar := u.velasDesde + 1
    true

// ───────────────────────── Velas en hora de Nueva York (crt/velas.py) ─────────────────────────

f_diaNY(int t) =>
    int(math.floor(timestamp("UTC", year(t, NY), month(t, NY), dayofmonth(t, NY), 0, 0) / 86400000.0))

// Día de trading (de 17:00 a 17:00), día de la semana (0 = lunes) y la vela de cada marco a la que pertenece
// una barra que empieza a la hora t.
f_claves(int t) =>
    int h = hour(t, NY)
    int dia0 = f_diaNY(t)
    int dia = dia0 + (h >= 17 ? 1 : 0)
    int hT = (h + 7) % 24
    int k1 = dia * 24 + hT
    int k3 = dia * 8 + math.floor(hT / 3.0)
    int h4t = h + 24 - inicio4h
    int k4 = (dia0 + (h4t >= 24 ? 1 : 0)) * 6 + math.floor((h4t % 24) / 4.0)
    int wd = (dia + 3) % 7
    int kW = dia - wd
    [dia, wd, k1, k3, k4, kW]

f_semanaDe(int t) =>
    [dia, wd, k1, k3, k4, kW] = f_claves(t)
    kW

// ───────────────────────── Marcos (crt/marcos.py) ─────────────────────────

method rangoMedio(Marco m) =>
    float r = na
    int n = array.size(m.cerradas)
    int k = math.min(n, 20)
    if k >= 5
        float s = 0.0
        for i = n - k to n - 1
            Vela v = array.get(m.cerradas, i)
            s += v.h - v.l
        r := s / k
    r

method relativo(Marco m, Vela v) =>
    float medio = m.rangoMedio()
    float r = na
    if not na(medio) and medio > 0
        r := (v.h - v.l) / medio
    r

// ¿La vela en curso ya pasó el extremo de la anterior hacia ese lado? En compras, «tomando máximos».
method tomando(Marco m, int d) =>
    bool r = false
    int n = array.size(m.cerradas)
    if not na(m.parcial) and n > 0
        Vela p = array.get(m.cerradas, n - 1)
        r := d > 0 ? m.parcial.h > p.h : m.parcial.l < p.l
    r

method sumar(Marco m, Vela b, int clave) =>
    if na(m.parcial)
        m.parcial := Vela.new(b.t, b.o, b.h, b.l, b.c, b.iIni, b.iFin)
        m.clave := clave
        m.barridoAlc := -1
        m.barridoBaj := -1
    else
        m.parcial.h := math.max(m.parcial.h, b.h)
        m.parcial.l := math.min(m.parcial.l, b.l)
        m.parcial.c := b.c
        m.parcial.iFin := b.iFin
    int n = array.size(m.cerradas)
    if n > 0
        Vela p = array.get(m.cerradas, n - 1)
        if m.barridoAlc < 0 and m.parcial.l < p.l
            m.barridoAlc := b.iFin
        if m.barridoBaj < 0 and m.parcial.h > p.h
            m.barridoBaj := b.iFin
    true

method cerrar(Marco m) =>
    Vela v = m.parcial
    m.parcial := na
    Evento u = m.ultimo
    if not na(u)
        if u.rango and u.estado == 0
            u.velasDesde += 1
            if (u.dir > 0 and v.c < u.barrido) or (u.dir < 0 and v.c > u.barrido)
                u.estado := 2
    int n = array.size(m.cerradas)
    Evento nuevo = na
    if n > 0
        Vela p = array.get(m.cerradas, n - 1)
        nuevo := f_evaluar(p, v)
        if not na(nuevo)
            nuevo.vela1Rel := m.relativo(p)
    array.push(m.cerradas, v)
    if array.size(m.cerradas) > 21
        array.shift(m.cerradas)
    if not na(nuevo)
        array.set(contador, 0, array.get(contador, 0) + 1)
        nuevo.id := array.get(contador, 0)
        nuevo.escenario := f_escenario(u, nuevo.dir)
        m.ultimo := nuevo
    true

// ───────────────────────── Setups: cerrados y anticipados ─────────────────────────

f_claveAnticipo(int codigo, int iIni, int d) =>
    (iIni * 8 + codigo) * 2 + (d > 0 ? 1 : 0)

f_cerrado(Marco m, int d) =>
    Setup s = na
    Evento u = m.ultimo
    if not na(u)
        if u.rango and u.estado == 0 and u.dir == d
            s := Setup.new(-u.id, f_claveAnticipo(m.codigo, u.iVelaIni, d), d, u.barrido, u.objetivo, u.iFormado, "cierre", u.escenario, u.vela1Rel)
    s

// La vela en curso ya barrió el extremo de la anterior (sin tomar también el otro) y el precio volvió dentro.
f_baseAnticipo(Marco m, int d, float precio) =>
    bool ok = false
    int ib = d > 0 ? m.barridoAlc : m.barridoBaj
    int n = array.size(m.cerradas)
    if not na(m.parcial) and n > 0 and ib >= 0
        Vela p = array.get(m.cerradas, n - 1)
        ok := p.l < precio and precio < p.h and not m.tomando(d)
    [ok, ib]

f_hacerAnticipo(Marco m, int d, int iInicio) =>
    Vela p = array.get(m.cerradas, array.size(m.cerradas) - 1)
    Setup.new(f_claveAnticipo(m.codigo, m.parcial.iIni, d), 0, d, d > 0 ? m.parcial.l : m.parcial.h, d > 0 ? p.h : p.l, iInicio, "anticipo", f_escenario(m.ultimo, d), m.relativo(p))

// El 4H antes de que cierre su vela: con un rango de 1H cerrado después del barrido. Con la regla candidata
// del autor, sin esperar al 1H: «nos toma el alto, empieza a reaccionar, creamos el order block».
f_anticipo4h(int d, float precio) =>
    Setup s = na
    [ok, ib] = f_baseAnticipo(h4, d, precio)
    if ok
        if anticipoSin1h
            s := f_hacerAnticipo(h4, d, ib)
        else
            Setup s1 = f_cerrado(h1, d)
            if not na(s1)
                if s1.iInicio >= ib
                    s := f_hacerAnticipo(h4, d, s1.iInicio)
    s

f_setup4h(int d, float precio) =>
    Setup s = f_cerrado(h4, d)
    if na(s)
        s := f_anticipo4h(d, precio)
    s

// El diario antes de que cierre su vela: con un rango de 4H formado después del barrido.
f_anticipoD1(int d, float precio) =>
    Setup s = na
    [ok, ib] = f_baseAnticipo(d1, d, precio)
    if ok
        Setup s4 = f_setup4h(d, precio)
        if not na(s4)
            if s4.via == "cierre" and s4.iInicio < ib
                s4 := f_anticipo4h(d, precio)
        if not na(s4)
            if s4.iInicio >= ib
                s := f_hacerAnticipo(d1, d, s4.iInicio)
    s

f_setupD1(int d, float precio) =>
    Setup s = f_cerrado(d1, d)
    if na(s)
        s := f_anticipoD1(d, precio)
    s

f_colorSimple(Marco m, int d) =>
    na(f_cerrado(m, d)) ? f_semaforo(m.ultimo, d) : "verde"

f_color4h(int d, float precio) =>
    na(f_setup4h(d, precio)) ? f_semaforo(h4.ultimo, d) : "verde"

f_colorD1(int d, float precio) =>
    na(f_setupD1(d, precio)) ? f_semaforo(d1.ultimo, d) : "verde"

// ───────────────────────── Semanal y mensual ─────────────────────────

// Se calcula con las velas semanales o mensuales de TradingView: el último evento de las velas ya cerradas.
f_crtCerradas() =>
    var bool uRango = false
    var int uDir = 0
    var float uObj = na
    var float uBarr = na
    var int uEstado = -1
    var int uId = 0
    if not na(close[1])
        if uEstado == 0 and uRango
            if (uDir > 0 and high[1] >= uObj) or (uDir < 0 and low[1] <= uObj)
                uEstado := 1
        if uEstado == 0 and uRango
            if (uDir > 0 and close[1] < uBarr) or (uDir < 0 and close[1] > uBarr)
                uEstado := 2
        if not na(close[2])
            bool tomaMin = low[1] < low[2]
            bool tomaMax = high[1] > high[2]
            int nDir = 0
            bool nRango = false
            if close[1] > high[2]
                nDir := 1
            else if close[1] < low[2]
                nDir := -1
            else if tomaMin and not tomaMax
                nDir := 1
                nRango := true
            else if tomaMax and not tomaMin
                nDir := -1
                nRango := true
            if nDir != 0
                uRango := nRango
                uDir := nDir
                uObj := nRango ? (nDir > 0 ? high[2] : low[2]) : na
                uBarr := nRango ? (nDir > 0 ? low[1] : high[1]) : na
                uEstado := 0
                uId += 1
    [uRango, uDir, uObj, uBarr, uEstado, uId]

[wR, wD, wO, wB, wE, wI] = request.security(syminfo.tickerid, "W", f_crtCerradas(), lookahead=barmerge.lookahead_on)
[mR, mD, mO, mB, mE, mI] = request.security(syminfo.tickerid, "M", f_crtCerradas(), lookahead=barmerge.lookahead_on)

// Manda el semanal; si no dice nada, el mensual. Si se contradicen, no hay sesgo y no se opera.
f_sesgoBot() =>
    int s = f_direccion(wU)
    int m = f_direccion(mU)
    int r = s
    if s == 0
        r := m
    else if m == -s and not sinVetoMensual
        r := 0
    r

f_sesgo(int kW) =>
    int r = f_sesgoBot()
    if sesgoEquipo != "El que calcula el bot" and kW == f_semanaDe(timenow)
        r := sesgoEquipo == "Compras" ? 1 : sesgoEquipo == "Ventas" ? -1 : 0
    r

f_textoDir(int d) =>
    d > 0 ? "compras" : d < 0 ? "ventas" : "sin sesgo"

// ───────────────────────── Casos del examen (casos/casos.csv) ─────────────────────────

var casoId = array.from("v3-lun-09-03", "v3-mar-10-03", "v3-mie-11-03", "v3-jue-12-03", "v3-vie-13-03", "v3-lun-16-03", "v3-mar-17-03", "v3-mie-18-03", "v3-ultimo", "v5-eurusd-jue-18", "v150k-mie-09-09", "v150k-vie-11-09-antes", "v150k-vie-11-09-ipc", "vunica-vie-07-08", "vsimple-mar-09-09", "vsimple-jue-18-09-londres", "vestr26-lun-17-11", "vestr26-vie-02-01", "vcurso-vie-16-01", "vbacktest-jue-01-05-compra", "vbacktest-jue-01-05-venta", "vbacktest-vie-02-05", "vbacktest-lun-05-05", "vbacktest-mar-06-05-venta", "vbacktest-mar-06-05-compra", "vbacktest-mie-07-05", "vbacktest-jue-08-05", "vbacktest-vie-09-05-compra", "vbacktest-vie-09-05-venta", "vfondeo-mie-01-10", "vfondeo-mie-08-10-londres", "vfondeo-mie-08-10")
